---
import BaseLayout from "../layouts/BaseLayout.astro";

const EMAIL = "hello@caldwellhumaneconsultants.com";
const LINKEDIN_COMPANY =
  "https://www.linkedin.com/company/caldwell-humane-animal-services-consultants/";
const LINKEDIN_FOUNDER =
  "https://www.linkedin.com/in/dr-antonio-l-caldwell-dba-cawa-5a68a5281/";

const challenges = [
  {
    num: "01",
    title: "Staffing Shortages",
    body:
      "Recruiting and retaining skilled, compassionate teams in a field that runs on heart — and runs people thin.",
  },
  {
    num: "02",
    title: "Financial Pressures",
    body:
      "Rising costs and limited resources strain sustainability and force impossible trade-offs.",
  },
  {
    num: "03",
    title: "Community Expectations",
    body:
      "Communities expect more services, more transparency, and faster response than ever before.",
  },
  {
    num: "04",
    title: "Rising Intake Numbers",
    body: "More animals in need than there are resources available to care for them.",
  },
];

const services = [
  {
    title: "Leadership Development",
    body:
      "Building confident, accountable leaders and boards who can carry the mission forward — long after the engagement ends.",
  },
  {
    title: "Operational Excellence",
    body:
      "Tightening the day-to-day systems — intake, staffing, workflows — so your team spends less time firefighting and more time saving lives.",
  },
  {
    title: "Strategy & Solutions",
    body:
      "Clear-eyed planning grounded in your reality. Where you are, where you're going, and the practical path between the two.",
  },
  {
    title: "Compassion & Community",
    body:
      "Programs and partnerships that deepen community trust, expand your reach, and keep more animals in safe homes.",
  },
  {
    title: "Impact & Sustainability",
    body:
      "Turning good intentions into measurable outcomes — and structures that keep those outcomes going year after year.",
  },
  {
    title: "Grant & Funding Development",
    body:
      "Finding the right funding, telling the story that wins it, and building the reporting that keeps funders coming back.",
  },
];

// Representative figures — NOT yet verified. Marked with ** + footnote per honest-proof rule.
const stats = [
  { val: "20+", lbl: "Years of Experience", desc: "Executive leadership in animal welfare & municipal government" },
  { val: "30+", lbl: "Organizations Supported", desc: "Shelters, humane societies, and animal welfare agencies" },
  { val: "$1M+", lbl: "Grant Dollars Secured", desc: "Funding that sustains the mission long-term" },
];
---

<BaseLayout>
  <!-- ============ NAV ============ -->
  <nav class="site-nav" id="main-nav">
    <div class="nav-inner">
      <a href="#hero" class="wordmark" aria-label="Caldwell Humane & Animal Services Consultants">
        <span class="wm-main">CALDWELL</span>
        <span class="wm-sub">Humane &amp; Animal Services Consultants</span>
      </a>
      <ul class="nav-links">
        <li><a href="#challenge">The Challenge</a></li>
        <li><a href="#services">Services</a></li>
        <li><a href="#approach">Approach</a></li>
        <li><a href="#about">About</a></li>
      </ul>
      <a href="#contact" class="btn-nav">Book a Consultation →</a>
    </div>
  </nav>

  <!-- ============ HERO ============ -->
  <section class="hero" id="hero">
    <div class="hero-text">
      <p class="hero-eyebrow">Humane &amp; Animal Services Consulting</p>
      <p class="hero-caldwell">CALDWELL</p>
      <p class="hero-consult">Humane &amp; Animal Services Consultants</p>
      <div class="hero-rule"></div>
      <p class="hero-tagline">
        Stronger organizations.<br />Safer communities.<br />More lives saved.
      </p>
      <p class="hero-sub">
        We help animal welfare organizations lead with clarity, operate with purpose, and create
        lasting impact — for animals, for people, and for the communities they serve.
      </p>
      <div class="hero-btns">
        <a href="#contact" class="btn-gold">Book a Consultation →</a>
        <a href="#services" class="btn-ghost-gold">Explore Our Services</a>
      </div>
    </div>
    <!-- TEMP IMAGE: placeholder dog+cat hero, pending final select -->
    <div class="hero-img">
      <img
        src="/images/hero.jpg"
        alt="A dog and cat together — the animals at the heart of stronger welfare organizations"
        loading="eager"
        width="1500"
        height="1000"
      />
    </div>
  </section>

  <!-- ============ TICKER ============ -->
  <div class="ticker" aria-hidden="true">
    <div class="ticker-track">
      {
        Array.from({ length: 2 }).map(() => (
          <>
            <span class="ticker-item">Mission Focused</span><span class="ticker-sep">◆</span>
            <span class="ticker-item">People Centered</span><span class="ticker-sep">◆</span>
            <span class="ticker-item">Operations Excellence</span><span class="ticker-sep">◆</span>
            <span class="ticker-item">Meaningful Impact</span><span class="ticker-sep">◆</span>
          </>
        ))
      }
    </div>
  </div>

  <!-- ============ IMPACT STRIP ============ -->
  <div class="impact-strip">
    <div class="impact-grid">
      {
        stats.map((s, i) => (
          <div class={`impact-item anim${i ? ` d${i}` : ""}`}>
            <p class="impact-num">{s.val}<span class="stat-mark">**</span></p>
            <p class="impact-lbl">{s.lbl}</p>
            <p class="impact-desc">{s.desc}</p>
          </div>
        ))
      }
    </div>
    <p class="impact-note stat-note">
      <span class="stat-mark">**</span> Representative figures — verification in progress.
    </p>
  </div>

  <!-- ============ CHALLENGE ============ -->
  <section class="challenge" id="challenge">
    <div class="container">
      <div class="ch-head anim">
        <p class="label">The Challenge</p>
        <h2>Animal welfare organizations face increasing operational challenges.</h2>
        <p>
          The landscape is evolving. The pressures are real. The organizations that thrive embrace
          strategy, innovation, and real operational change.
        </p>
      </div>
      {
        challenges.map((c, i) => (
          <div class={`ch-strip anim${i ? ` d${i}` : ""}`}>
            <p class="ch-strip-num">{c.num}</p>
            <p class="ch-strip-title">{c.title}</p>
            <p class="ch-strip-desc">{c.body}</p>
          </div>
        ))
      }
      <p class="challenge-outro anim">
        The future of animal welfare leadership will require adaptability and vision. That's where we
        come in.
      </p>
    </div>
  </section>

  <!-- ============ SERVICES ============ -->
  <section class="services" id="services">
    <div class="container">
      <div class="svc-head anim">
        <p class="label">What We Do</p>
        <h2>Six ways we strengthen the organizations that protect animals.</h2>
        <p>Every engagement is tailored to where your organization is today — and where it needs to go.</p>
      </div>
      <div class="svc-grid">
        {
          services.map((s, i) => (
            <div class={`svc-card anim${i % 3 ? ` d${i % 3}` : ""}`}>
              <h3 set:html={s.title} />
              <p set:html={s.body} />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ PULL QUOTE ============ -->
  <section class="quote-sec">
    <div class="container">
      <blockquote class="big-quote anim">
        People may forget specific decisions. They rarely forget how leaders made them feel.
      </blockquote>
    </div>
  </section>

  <!-- ============ APPROACH ============ -->
  <section class="approach" id="approach">
    <div class="approach-copy anim">
      <p class="label">Our Approach</p>
      <h2>Strong organizations are not built by accident.</h2>
      <ul class="approach-bullets">
        <li><strong>Clear expectations.</strong> Everyone knows what good looks like.</li>
        <li><strong>Consistent communication.</strong> Trust is built in the everyday.</li>
        <li><strong>Mission alignment.</strong> Every decision points back to the work.</li>
      </ul>
      <blockquote class="approach-quote">
        Built through intentional leadership, accountability, operational clarity, and a culture that
        empowers people to succeed.
      </blockquote>
    </div>
    <!-- TEMP IMAGE: placeholder, pending final select -->
    <div class="approach-img">
      <img
        src="/images/approach-real.jpg"
        alt="A dog nuzzling a cat — the ripple effect of care across animals, people, and communities"
        loading="lazy"
        width="825"
        height="550"
      />
    </div>
  </section>

  <!-- ============ ABOUT ============ -->
  <section class="about" id="about">
    <div class="container">
      <div class="about-grid">
        <div class="about-copy anim">
          <p class="label">About Caldwell</p>
          <h2>Leadership built from the ground up — and proven in the field.</h2>
          <p>
            Caldwell Humane &amp; Animal Services Consultants was founded on a simple belief: that the
            animals and communities we care about are best served by organizations that are healthy,
            well-led, and built to last.
          </p>
          <p>
            Our founder brings 20+ years of experience driving operational excellence, organizational
            transformation, and strategic growth across municipal government, animal welfare,
            procurement, education, and finance. This is leadership that has been tested at every level
            of the field — and the results to show for it.
          </p>
          <p>
            This practice exists to bring that caliber of expertise directly to the organizations doing
            the hardest and most important work.
          </p>
          <a href="#contact" class="about-link">Start the Conversation →</a>
        </div>
        <div class="founder-card anim d1">
          <img
            class="founder-img"
            src="/images/antonio.png"
            alt="Antonio Caldwell, Founder & Principal Consultant"
            loading="lazy"
            width="600"
            height="750"
          />
          <div class="founder-info">
            <p class="founder-name">Dr. Antonio L. Caldwell, DBA, CAWA</p>
            <p class="founder-title">Founder &amp; Principal Consultant</p>
            <p class="founder-cred">
              20+ years · Animal Welfare · Municipal Government<br />Organizational Transformation ·
              Strategic Growth
            </p>
            <a
              class="founder-link"
              href={LINKEDIN_FOUNDER}
              target="_blank"
              rel="noopener"
              aria-label="Antonio Caldwell on LinkedIn"
            >
              Connect on LinkedIn →
            </a>
          </div>
        </div>
      </div>
      <div class="about-stats anim">
        {
          stats.map((s) => (
            <div class="astat">
              <p class="astat-lbl">{s.lbl.split(" ")[0]}</p>
              <p class="astat-val">{s.val}<span class="stat-mark">**</span></p>
              <p class="astat-desc">{s.desc}</p>
            </div>
          ))
        }
      </div>
      <p class="stat-note about-stats-note">
        <span class="stat-mark">**</span> Representative figures — verification in progress.
      </p>
    </div>
  </section>

  <!-- ============ CTA ============ -->
  <section class="cta-sec" id="contact">
    <div class="container">
      <h2>Ready to build a stronger organization?</h2>
      <p>
        Tell us where your organization is today. We'll show you what's possible — and the practical
        next step to get there.
      </p>
      <div class="cta-btns">
        <a href={`mailto:${EMAIL}`} class="btn-navy">Book a Consultation →</a>
        <a href="#services" class="btn-outline-navy">See How We Help</a>
      </div>
    </div>
  </section>

  <!-- ============ FOOTER ============ -->
  <footer class="site-footer">
    <div class="container">
      <div class="ft-top">
        <div class="ft-brand">
          <a href="#hero" class="wordmark">
            <span class="wm-main">CALDWELL</span>
            <span class="wm-sub">Humane &amp; Animal Services Consultants</span>
          </a>
          <p class="ft-tagline">Stronger Organizations. Safer Communities. More Lives Saved.</p>
        </div>
        <div class="ft-col">
          <h4>Explore</h4>
          <ul>
            <li><a href="#challenge">The Challenge</a></li>
            <li><a href="#services">Services</a></li>
            <li><a href="#approach">Approach</a></li>
            <li><a href="#about">About</a></li>
          </ul>
        </div>
        <div class="ft-col">
          <h4>Connect</h4>
          <ul>
            <li><a href={`mailto:${EMAIL}`}>Email Us</a></li>
            <li><a href={LINKEDIN_COMPANY} target="_blank" rel="noopener">LinkedIn</a></li>
            <li><a href="#contact">Book a Consultation</a></li>
          </ul>
        </div>
      </div>
      <div class="ft-bottom">
        <p class="ft-copy">
          © {new Date().getFullYear()} Caldwell Humane &amp; Animal Services Consultants LLC. Built with
          purpose.
        </p>
      </div>
    </div>
  </footer>
</BaseLayout>
